# Copy to .env. Nothing here has a coded default except the Ollama URL, the model and num_ctx.

OLLAMA_URL=http://127.0.0.1:11434
MODEL=qwen3:14b
NUM_CTX=8192
LLM_TIMEOUT=300
NUM_PREDICT=1024
# true on an instance rio must never change (the corporate one): no write tool is offered or run
RIO_READ_ONLY=false
# The instance-config snapshot of THIS instance (enables now_field_exists / now_choice_values).
# Make it with `python -m rio.snapshot`, which prints the full line to put here.
INSTANCE_CONFIG_ROOT=
# Where a triage proposal waits for `apply triage` (default: .\state). It holds ticket text.
RIO_STATE_DIR=

# ServiceNow: the bare instance name (dev442835) or its https URL, and ONE identity pair.
SN_INSTANCE=
# human (default) -> SN_HUMAN_USER / SN_HUMAN_PASSWORD; machine; agent; legacy -> SN_USER / SN_PASSWORD
SN_IDENTITY=human
SN_HUMAN_USER=
SN_HUMAN_PASSWORD=
# servicenow-coder's names, read when SN_IDENTITY=legacy, so one .env can serve both repos:
SN_USER=
SN_PASSWORD=
